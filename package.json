{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-service-worker.mjs && next dev",
    "build": "node scripts/check-production-env.mjs && node scripts/generate-service-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test:communication": "node --test scripts/communication-viewport.test.mjs scripts/chat.test.mjs scripts/moto-z3.test.mjs",
    "test:calls:ui": "playwright test --config=playwright.calls.config.mjs",
    "test:mail": "node --test scripts/mail-document.test.mjs",
    "test:ai": "node --test scripts/ai.test.mjs",
    "test:ai:ui": "playwright test --config=playwright.ai.config.mjs",
    "test:attendance": "node --test scripts/attendance.test.mjs scripts/attendance-api.test.mjs",
    "test:payroll:ui": "playwright test --config=playwright.payroll.config.mjs",
    "check:production": "node scripts/check-production-env.mjs",
    "test:production": "node --test scripts/production.test.mjs"
  },
  "engines": { "node": ">=20.0.0" },
  "dependencies": {
    "@next/env": "16.3.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
